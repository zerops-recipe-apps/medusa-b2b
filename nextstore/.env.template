# Your Medusa backend, should be updated to where you are hosting your server.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Your publishable key from Admin → Settings → API Key Management.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test

# Your store URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# ISO-2 lowercase. Seed creates a Europe region that includes `de`.
NEXT_PUBLIC_DEFAULT_REGION=de

# Optional Medusa Payments / Stripe
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
NEXT_PUBLIC_STRIPE_KEY=

# Used by /api/internal/reload-env (Zerops maps RELOAD_SECRET here).
REVALIDATE_SECRET=supersecret
